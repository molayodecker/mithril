# Mithril runtime configuration example.
#
# Do not commit real credentials. Production secrets belong in Fly secrets.

# Required in production
DATABASE_URL=postgresql://user:password@host:5432/database
SECRET_KEY_BASE=replace-with-a-generated-secret
PHX_HOST=instaclean-mithril.fly.dev

# Runtime tuning
PORT=4000
POOL_SIZE=5
ECTO_IPV6=false

# Temporary migration-only internal parity API.
# Leave unset to disable authenticated parity access entirely.
MITHRIL_PARITY_TOKEN=replace-with-a-random-secret
