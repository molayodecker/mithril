# Mithril runtime configuration example.
#
# Do not commit real credentials. Production secrets belong in Fly secrets.

# Which PostgreSQL Mithril should use: "fly" or "supabase".
# Production default is fly (see fly.toml). Override without a deploy:
#   fly secrets set DATABASE_BACKEND=supabase -a instaclean-mithril
#   fly secrets unset DATABASE_BACKEND -a instaclean-mithril
DATABASE_BACKEND=supabase

# Local sync source remains live Supabase (session/direct, port 5432).
# SOURCE_DATABASE_URL=postgresql://user:password@host:5432/postgres
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/postgres
FLY_DATABASE_URL=postgresql://user:password@host:5432/fly-db
# Staging is a separate Fly MPG cluster (instaclean-mithril-staging-pg).
# FLY_STAGING_DATABASE_URL=postgresql://fly-user:password@127.0.0.1:16381/fly-db
#
# Local overlay (gitignored): copy this file to .env.staging and fill from the
# Instaclean/instaclean-mobile staging project (jzevawnetjwnliamyilb). Load with:
#   set -a && source .env.staging && set +a
# DATABASE_URL is still accepted as a Supabase fallback when
# SUPABASE_DATABASE_URL is unset and DATABASE_BACKEND=supabase.
SECRET_KEY_BASE=replace-with-a-generated-secret
PHX_HOST=api.tryinstaclean.com

# Runtime tuning
PORT=4000
POOL_SIZE=5
ECTO_IPV6=false

# Mithril JWT login. Optional; defaults to SECRET_KEY_BASE.
AUTH_JWT_SECRET=replace-with-a-generated-secret
# AUTH_ACCESS_TTL=3600
# AUTH_REFRESH_TTL=2592000

# Admin or reviewer for the frontend API. The user must already exist:
#   mix mithril.staff.grant --phone +233… --role reviewer
#   mix mithril.staff.grant --email you@tryinstaclean.com --role admin
# Then sign in through POST /auth/login or POST /auth/otp. GET /auth/me
# returns "admin" and/or "reviewer". Add the number to AUTH_TEST_PHONES
# when you do not want Twilio to send a real message.

# Google Sign-In / Facebook Login (comma-separated Google client IDs).
# GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,ios-client-id.apps.googleusercontent.com
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Phone OTP via Twilio. Unset keeps phone login disabled.
# Prefer the same Messaging Service Instaclean uses for SMS.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_PHONE_NUMBER=

# WhatsApp cleaner recruitment bot (join-as-cleaner-bot).
# Point the Twilio WhatsApp sandbox / number webhook at Mithril:
#   TWILIO_WEBHOOK_URL=https://api.tryinstaclean.com/whatsapp/join-as-cleaner-bot
# Optional alias so an existing Edge Function URL keeps verifying:
#   TWILIO_WEBHOOK_URL_ALIAS=https://api.tryinstaclean.com/functions/v1/join-as-cleaner-bot
# APP_URL stays the public www origin used in APPLY / WEB / SIGNUP links.
# APP_URL=https://tryinstaclean.com
# TWILIO_WHATSAPP_ADMIN_FROM=+233559100642
# TWILIO_WHATSAPP_WELCOME_CONTENT_SID=
# TWILIO_WHATSAPP_YES_NO_CONTENT_SID=
# TWILIO_WHATSAPP_ACCEPT_CONTENT_SID=
# TWILIO_WHATSAPP_SUBMIT_CONTENT_SID=
# TWILIO_WHATSAPP_EQUIPMENT_CONTENT_SID=
# RECRUITMENT_LEAD_APPLICATION_SYNC_SECRET=
# DISABLE_TWILIO_SIGNATURE_VALIDATION=  # non-production only

# Optional. Same idea as Supabase Auth test phone numbers: skip Twilio for
# these numbers and accept the paired OTP. Comma-separated phone:otp pairs.
# AUTH_TEST_PHONES=+15555550100:123456,+233555000000:000000

# Optional server-to-server Direct gateway. User JWTs are preferred.
MITHRIL_DIRECT_TOKEN=replace-with-a-random-secret

# Client self-serve POST /direct/bookings. Default off. Admin/reviewer
# concierge booking stays available either way.
# DIRECT_CLIENT_BOOKINGS=false

# Paystack Direct checkout. Unset keeps payment initialization disabled.
# PAYSTACK_SECRET_KEY=sk_test_replace_me
# Point Paystack at POST /webhooks/paystack. Signature is HMAC-SHA512 of the
# raw body, header x-paystack-signature, keyed by PAYSTACK_SECRET_KEY.

# Sumsub inbound webhook. HMAC-SHA256 of the raw body, header x-payload-digest.
# Point Sumsub at POST /webhooks/sumsub on the API host.
# SUMSUB_WEBHOOK_SECRET=
# Sumsub KYC level accepted for user verification (default: id-and-liveness).
# SUMSUB_LEVEL_NAME=id-and-liveness

# Concierge/dispatch notifications. Admin chooses per booking or assignment.
# When SEND_NOTIFICATION_URL is set, Mithril uses Instaclean's send-notification
# edge function (email + SMS + WhatsApp templates). Otherwise Twilio SMS is used.
# Visit reminders for Direct concierge bookings run in Oban hourly.
# SEND_NOTIFICATION_URL=https://<project>.supabase.co/functions/v1/send-notification
# SEND_NOTIFICATION_TOKEN=
# DIRECT_PUBLIC_URL=https://direct.tryinstaclean.com

# Temporary migration-only internal parity API.
# Leave unset to disable authenticated parity access entirely.
MITHRIL_PARITY_TOKEN=replace-with-a-random-secret
